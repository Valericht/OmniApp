<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🤖 Omni-3X"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/bAdv"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lanjutan ⚙" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cWifi"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="WiFi: menyambung" />

                <TextView
                    android:id="@+id/cLat"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="- ms" />

                <TextView
                    android:id="@+id/cMode"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="-" />

                <TextView
                    android:id="@+id/cPad"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="gamepad -" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/banner"
                style="@style/Alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_alert_bad"
                android:text="Belum tersambung ke robot."
                android:textColor="@color/omni_bad" />

            <LinearLayout
                android:id="@+id/aSafe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_alert_bad"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSafe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/omni_bad"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/bResume"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_go"
                    android:text="Lanjut (buka kunci)"
                    android:textColor="@color/omni_white" />
            </LinearLayout>

            <!-- Kontrol manual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KONTROL MANUAL" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3">

                    <Button
                        android:id="@+id/bJog5"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="⟲ Putar kiri" />

                    <Button
                        android:id="@+id/bJog1"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="▲ Maju" />

                    <Button
                        android:id="@+id/bJog6"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="Putar kanan ⟳" />

                    <Button
                        android:id="@+id/bJog3"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="◀ Kiri" />

                    <Button
                        android:id="@+id/bPadStop"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_btn_stop"
                        android:text="STOP"
                        android:textColor="@color/omni_white"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/bJog4"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="Kanan ▶" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_columnWeight="1" />

                    <Button
                        android:id="@+id/bJog2"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="▼ Mundur" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_columnWeight="1" />
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/jgStat"
                        style="@style/Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="diam" />

                    <TextView
                        style="@style/Mut"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Tahan = jalan, lepas = berhenti" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Kecepatan manual: - RPM"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/sbSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="500"
                    android:min="30"
                    android:progress="150" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simpan sebagai"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spJogWp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbAutoSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="simpan otomatis saat STOP"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/bStopSave"
                    style="@style/Btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_btn_go"
                    android:text="STOP dan simpan posisi"
                    android:textColor="@color/omni_white"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preset -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/H2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PRESET WAYPOINT" />

                    <TextView
                        android:id="@+id/preInfo"
                        style="@style/Mut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDLE" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/bPre0"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:minHeight="76dp"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:text="A" />

                    <Button
                        android:id="@+id/bPre1"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:minHeight="76dp"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:text="B" />

                    <Button
                        android:id="@+id/bPre2"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:minHeight="76dp"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:text="C" />

                    <Button
                        android:id="@+id/bPre3"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:minHeight="76dp"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:text="D" />
                </LinearLayout>

                <TextView
                    style="@style/Mut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tekan sekali = langsung jalan; di tiap waypoint ber-yaw robot berputar ke yaw-nya sebelum lanjut. STOP = batal." />
            </LinearLayout>

            <!-- Posisi robot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="POSISI ROBOT" />

                <com.omni.monitor.MapView
                    android:id="@+id/mapView"
                    android:layout_width="match_parent"
                    android:layout_height="320dp" />

                <TextView
                    android:id="@+id/tvPoseWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:columnCount="3">

                    <TextView
                        android:id="@+id/tPos0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_tile"
                        android:padding="7dp" />

                    <TextView
                        android:id="@+id/tPos1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_tile"
                        android:padding="7dp" />

                    <TextView
                        android:id="@+id/tPos2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_tile"
                        android:padding="7dp" />

                    <TextView
                        android:id="@+id/tPos3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_tile"
                        android:padding="7dp" />

                    <TextView
                        android:id="@+id/tPos4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_tile"
                        android:padding="7dp" />

                    <TextView
                        android:id="@+id/tPos5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/bg_tile"
                        android:padding="7dp" />
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/bZero"
                        style="@style/Btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_go"
                        android:text="Set titik 0 (posisi dan arah)"
                        android:textColor="@color/omni_white"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/bClearTrail"
                        style="@style/Btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hapus jejak" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTrail"
                    style="@style/Mut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Jejak (X, Y, Yaw) direkam saat robot digerakkan manual." />
            </LinearLayout>

            <!-- Waypoint -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WAYPOINT" />

                <LinearLayout
                    android:id="@+id/wpTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/bWpMore"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tampilkan semua ▾"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Motor -->
            <include
                android:id="@+id/motor1"
                layout="@layout/card_motor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/motor2"
                layout="@layout/card_motor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <include
                android:id="@+id/motor3"
                layout="@layout/card_motor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RPM RODA · 30 DETIK TERAKHIR" />

                <TextView
                    android:id="@+id/tvLegend"
                    style="@style/Mut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="6dp" />

                <com.omni.monitor.RpmChart
                    android:id="@+id/rpmChart"
                    android:layout_width="match_parent"
                    android:layout_height="230dp" />
            </LinearLayout>

            <!-- Koreksi dinding -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KOREKSI DINDING" />

                <LinearLayout
                    android:id="@+id/kvWall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- IMU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMU BNO055" />

                <LinearLayout
                    android:id="@+id/kvImu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvImuNote"
                    style="@style/Mut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Ultrasonik -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ULTRASONIK" />

                <LinearLayout
                    android:id="@+id/kvUs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvUsHint"
                    style="@style/Mut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Pengaman -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PENGAMAN" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbSafety"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Aktif"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/safeChip"
                        style="@style/Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/kvSafe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Medan, selip, PID yaw -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MEDAN · SELIP · PID YAW" />

                <LinearLayout
                    android:id="@+id/rowAsst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/kvAsst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <com.omni.monitor.CenterBar
                    android:id="@+id/barTrust"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Sambungan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SAMBUNGAN" />

                <LinearLayout
                    android:id="@+id/kvLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Kejadian -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KEJADIAN" />

                <TextView
                    android:id="@+id/tvEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/bStop"
        style="@style/Btn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_btn_stop"
        android:text="STOP"
        android:textColor="@color/omni_white"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
