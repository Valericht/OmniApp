<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="H2">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/omni_mut</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Mut">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/omni_mut</item>
    </style>

    <style name="Chip">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/omni_fg</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/omni_fg</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Alert">
        <item name="android:padding">10dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
